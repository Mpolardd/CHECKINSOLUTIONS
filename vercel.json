{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npx prisma generate --schema=backend/prisma/schema.prisma && cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/finance", "destination": "/finance.html" },
    { "source": "/checkin", "destination": "/checkin.html" },
    { "source": "/kiosk", "destination": "/checkin.html" }
  ]
}
